# ============================================================
#  MrBiznes Trading Bot — نمونه فایل تنظیمات
#  ساخت فایل اصلی:   cp .env.example .env
#  نکته: فایل .env را هیچ‌وقت در گیت‌هاب/چت نفرستید.
# ============================================================


# ------------------------------------------------------------
#  ۱) اتصال به تلگرام (اجباری)
#  توکن را از @BotFather می‌گیرید.
# ------------------------------------------------------------
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#  شناسه عددی تلگرام ادمین‌ها (چند نفر با کاما).
#  شناسه خودتان را با ارسال /id به ربات یا از @userinfobot بگیرید.
ADMIN_IDS=

#  کانال اجباری عضویت (اگر خالی باشد، بررسی عضویت انجام نمی‌شود)
REQUIRED_CHANNEL=@MrBiznesMarket
REQUIRED_CHANNEL_URL=https://t.me/MrBiznesMarket


# ------------------------------------------------------------
#  ۲) پروکسی و شبکه
#  ⚠️ اگر سرور داخل ایران است، این بخش را پر کنید.
#  ⚠️ اگر روی Railway / سرور خارج از ایران اجرا می‌کنید،
#     این بخش را خالی بگذارید (اتصال مستقیم درست است).
#
#  فقط SOCKS5 یا HTTP کار می‌کند؛ پروکسی MTProto تلگرام
#  برای ربات کار نمی‌کند (آن فقط برای اپلیکیشن تلگرام است).
#
#  نمونه‌ها:
#     BOT_PROXY_URL=socks5://127.0.0.1:1080
#     BOT_PROXY_URL=socks5://user:pass@1.2.3.4:1080
#     BOT_PROXY_URL=http://127.0.0.1:8080
# ------------------------------------------------------------
BOT_PROXY_URL=

#  اختیاری: اگر می‌خواهید دریافت پیام‌ها (getUpdates) از پروکسی
#  دیگری رد شود، این را پر کنید. خالی باشد همان BOT_PROXY_URL است.
BOT_UPDATES_PROXY_URL=

#  اگر ۱ باشد، همان پروکسی برای تب‌های بازار/اخبار/اسکنر
#  (درخواست‌های requests) هم استفاده می‌شود. پیش‌فرض ۰ است چون
#  بعضی پروکسی‌ها فقط اجازه تلگرام می‌دهند و بقیه را خراب می‌کنند.
#  اگر پروکسی‌تان عمومی است (تونل SSH یا Xray روی سرور خودتان)
#  می‌توانید ۱ بگذارید.
BOT_PROXY_FOR_ALL=0

#  اختیاری: افزایش مهلت‌ها روی اینترنت ناپایدار (ثانیه)
#  BOT_CONNECT_TIMEOUT=20
#  BOT_READ_TIMEOUT=30
#  BOT_POOL_TIMEOUT=5

#  اگر ۱ باشد، پیام‌های عقب‌افتاده‌ی زمان خاموشی ربات دور ریخته
#  می‌شوند (توصیه می‌شود بعد از مدت‌ها خاموشی، یک‌بار ۱ بگذارید).
BOT_DROP_PENDING_UPDATES=0


# ------------------------------------------------------------
#  ۳) کلیدهای سرویس‌های بازار (اختیاری ولی توصیه‌شده)
# ------------------------------------------------------------
#  صرافی XT — برای قیمت/جستجوی کریپتو
XT_API_KEY=
XT_SECRET_KEY=
XT_ACCESS_KEY=

#  TwelveData — برای فارکس
TWELVE_DATA_API_KEY=

#  تحلیل چارت PLT با هوش مصنوعی (اگر خالی باشد، بخش PLT
#  پیام راهنما می‌دهد و بقیه ربات کار می‌کند)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# PLT_OPENAI_MODEL=gpt-4o-mini
# PLT_FALLBACK_MODEL=meta-llama/llama-3.2-90b-vision-instruct

#  LiveCoinWatch — انتخاب خودکار ۱۵ ارز برتر برای اسکنر PLT
LIVECOINWATCH_API_KEY=


# ------------------------------------------------------------
#  ۴) سیگنال‌های نهایی (Final Signal Worker)
# ------------------------------------------------------------
#  نمادها با کاما؛ خالی یعنی فهرست پیش‌فرض
FINAL_SIGNAL_SYMBOLS=
#  ۱ = ارسال سیگنال‌ها فعال
FINAL_SIGNALS_PUSH=1
# SIGNAL_DATA_DIR=data


# ------------------------------------------------------------
#  ۵) آدرس‌های پرداخت (روی کارت پرداخت نمایش داده می‌شود)
# ------------------------------------------------------------
BTC_PAYMENT_ADDRESS=
ETH_PAYMENT_ADDRESS=
TRON_PAYMENT_ADDRESS=
SOL_PAYMENT_ADDRESS=
USDT_TRC20_ADDRESS=
USDT_ERC20_ADDRESS=


# ------------------------------------------------------------
#  ۶) لینک‌های «درباره ما» و کانال‌های خبری
# ------------------------------------------------------------
WEBSITE_URL=
YOUTUBE_URL=
INSTAGRAM_URL=
X_URL=
WHATSAPP_URL=
FOREX_NEWS_CHANNEL_URL=
CRYPTO_NEWS_CHANNEL_URL=


# ============================================================
#  ۷) اسکنر PLT Range (سرویس کرون جداگانه)
#  این بخش فقط برای سرویس/کرونی است که
#  `python plt_range_scanner.py` را اجرا می‌کند.
# ============================================================
#  توکن همان ربات (برای پست کردن در کانال)
TELEGRAM_BOT_TOKEN=
#  شناسه عددی کانال خصوصی، مثل -1001234567890
PLT_RANGE_CHANNEL_ID=

PLT_RANGE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,LTCUSDT
PLT_RANGE_MIN_SCORE=65
PLT_RANGE_LCW_TOP=15
PLT_RANGE_SEND_EMPTY=1
PLT_RANGE_CARD=1
# PLT_RANGE_HTTP_TIMEOUT=20

#  اختیاری و فقط برای سازگاری (خواندنی است، سفارش نمی‌دهد)
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=
