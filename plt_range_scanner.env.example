# ============================================================
# PLT RANGE SCANNER — CONFIG (.env.example)
# Copy to .env on the server that runs the cron job:
#   cp .env.example .env   then edit values
# ============================================================

# ------------------------------------------------------------
# Symbols to scan (comma separated). Default: BTCUSDT,ETHUSDT,...
# Used when LiveCoinWatch is NOT configured.
# ------------------------------------------------------------
PLT_RANGE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,LTCUSDT

# ------------------------------------------------------------
# Optional: LiveCoinWatch top market-cap universe
# (needs LIVECOINWATCH_API_KEY). Overrides PLT_RANGE_SYMBOLS.
# ------------------------------------------------------------
LIVECOINWATCH_API_KEY=
PLT_RANGE_LCW_TOP=15

# ------------------------------------------------------------
# Range detection thresholds
# ------------------------------------------------------------
PLT_RANGE_MIN_SCORE=65
PLT_RANGE_SMA_FAN_PCT=3.0

# ------------------------------------------------------------
# Telegram channel push — REQUIRED for posting results
#   TELEGRAM_BOT_TOKEN : bot token from @BotFather
#   PLT_RANGE_CHANNEL_ID : numeric channel id or @channelusername
# The bot MUST be an admin of the private channel.
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
PLT_RANGE_CHANNEL_ID=

# ------------------------------------------------------------
# Push behaviour
#   PLT_RANGE_SEND_EMPTY=1  -> post a short "no setup" summary each run
#   PLT_RANGE_CARD=1        -> send glass-style PNG cards for active setups
#   PLT_RANGE_FORCE_POST=0  -> set 1 to always resend full cards
# ------------------------------------------------------------
PLT_RANGE_SEND_EMPTY=1
PLT_RANGE_CARD=1
PLT_RANGE_FORCE_POST=0

# ------------------------------------------------------------
# Bitunix API (OPTIONAL — public candles need NO credentials).
# Values are accepted for compatibility only and are never used
# for private/signed calls. This scanner is read-only.
# ------------------------------------------------------------
BITUNIX_API_KEY=
BITUNIX_SECRET_KEY=
# BITUNIX_BASE_URL=https://fapi.bitunix.com/api/v1/futures/market/kline

# ------------------------------------------------------------
# Misc
# ------------------------------------------------------------
# PLT_RANGE_HTTP_TIMEOUT=20
