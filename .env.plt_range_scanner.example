# ============================================================
# PLT RANGE SCANNER — DEDICATED ENV (separate from the bot's .env)
# ============================================================
# This file belongs ONLY to the cron job plt_range_scanner.py.
# Copy/rename to: .env.plt_range_scanner  (git-ignored) and fill in.
#
# LiveCoinWatch DEDICATED key for the scanner.
# Use a SEPARATE key from the bot's, so usage/quota is isolated.
PLT_SCANNER_LIVECOINWATCH_API_KEY=

# Optional overrides (defaults shown)
# PLT_RANGE_MARKET=spot
# PLT_RANGE_SYMBOLS=
# PLT_RANGE_MAX_SYMBOLS=10
# PLT_RANGE_LOOKBACK=20
# PLT_RANGE_MAX_WIDTH_PCT=6.0
# PLT_RANGE_MAX_DIST_SMA25_PCT=2.5
# PLT_RANGE_RSI_MIN=40
# PLT_RANGE_RSI_MAX=60
# LCW_LIMIT=15
# LCW_MIN_CAP_USD=100000000
# PLT_SCANNER_ENV=/custom/path/to/env-file
